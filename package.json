{
  "name": "ast-impact-mapper-mcp",
  "version": "0.1.1",
  "description": "MCP server that uses TypeScript AST to find which tests are affected by a code change",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ast-impact-mapper-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "chmod +x dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "typescript",
    "ast",
    "playwright",
    "mcp",
    "testing",
    "impact-analysis",
    "sdet"
  ],
  "author": "vola-trebla",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "**/*.{ts,mjs,json,md}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "mcpName": "io.github.vola-trebla/ast-impact-mapper-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vola-trebla/ast-impact-mapper-mcp.git"
  }
}
